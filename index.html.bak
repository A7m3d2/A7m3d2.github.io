<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="downtown">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>شركة الانطباع الفريد للديكور | UIDC</title>
  <meta name="description" content="شركة الانطباع الفريد للديكور (UIDC) في الرياض: تصميم داخلي، ديكورات خشبية، وأبواب فاخرة.">
  <meta name="theme-color" content="#0B111B">
  <link rel="icon" type="image/png" href="logo.png">

  <!-- Canonical Google Fonts (Alexandria for Headings, Cairo for UI & Body, Tajawal for Editorial) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Alexandria:wght@300;400;500;600;700;800;900&family=Cairo:wght@400;500;600;700;800&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">

  <!-- Qahera UI Kit via jsDelivr CDN -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/qahera-ui@1.5.5/dist/qahera-tokens.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/qahera-ui@1.5.5/dist/qahera-themes.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/alwkala/Qahera-UI-Kit@6c6180b1d0b6abbdf60321ba77a2ff5661189d3d/dist/qahera.min.css">

  <!--
    UIDC brand token overrides — CSS custom properties ONLY (no selectors styling elements).
    Scope 1  [data-theme="downtown"]                  = dark obsidian sections (default, set on <html>).
    Scope 2  [data-theme="downtown"][data-mode="light"] = clean white sections.
    Primary  #0E1622  blackish navy        Accent #987146  bronze (sampled from logo.png)
  -->
  <style>
    /* Strict Downtown Sharp Architecture (Zero Radius Policy) */
    *, *::before, *::after {
      border-radius: 0px !important;
    }

    [data-theme="downtown"] {
      /* Typography */
      --qhr-font-heading: 'Alexandria', 'Cairo', system-ui, sans-serif;
      --qhr-font-body: 'Cairo', 'Tajawal', system-ui, sans-serif;

      /* Downtown = sharp: zero radius everywhere */
      --qhr-radius: 0px !important;
      --qhr-radius-none: 0px !important;
      --qhr-radius-xs: 0px !important;
      --qhr-radius-sm: 0px !important;
      --qhr-radius-md: 0px !important;
      --qhr-radius-lg: 0px !important;
      --qhr-radius-xl: 0px !important;
      --qhr-radius-2xl: 0px !important;
      --qhr-radius-full: 0px !important;
      --qhr-radius-pill: 0px !important;
      --qhr-radius-box: 0px !important;
      --qhr-radius-field: 0px !important;
      --qhr-radius-selector: 0px !important;

      /* Obsidian navy surfaces */
      --qhr-surface-base: #0B111B;
      --qhr-surface-page: #0B111B;
      --qhr-surface-cinematic: #0B111B;
      --qhr-surface-elevated: #121B29;
      --qhr-surface-card: #121B29;
      --qhr-surface-muted: #1A2535;
      --qhr-surface-subtle: rgba(152, 113, 70, 0.10);
      --qhr-color-bg: #0B111B;
      --qhr-color-surface: #121B29;
      --qhr-color-surface-elevated: #1A2535;

      --qhr-content-primary: #F4EFE7;
      --qhr-content-secondary: #CBC3B7;
      --qhr-content-muted: #A39B8F;
      --qhr-text-primary: #F4EFE7;
      --qhr-text-secondary: #CBC3B7;
      --qhr-text-muted: #A39B8F;
      --qhr-color-text-primary: #F4EFE7;
      --qhr-color-text-secondary: #CBC3B7;
      --qhr-color-text-muted: #A39B8F;

      --qhr-border-subtle: rgba(152, 113, 70, 0.22);
      --qhr-border-strong: rgba(152, 113, 70, 0.55);
      --qhr-color-border: rgba(152, 113, 70, 0.30);
      --qhr-color-border-subtle: rgba(152, 113, 70, 0.22);
      --qhr-color-border-strong: rgba(152, 113, 70, 0.55);

      /* Brand: primary navy, accent bronze */
      --qhr-color-primary: #0E1622;
      --qhr-color-primary-bg: #0E1622;
      --qhr-color-primary-fg: #FFFFFF;
      --qhr-color-primary-hover: #1C2838;
      --qhr-color-primary-focus: rgba(152, 113, 70, 0.45);
      --qhr-color-primary-base: #987146;
      --qhr-color-primary-400: #B8915F;
      --qhr-color-primary-500: #B8915F;
      --qhr-color-primary-600: #987146;
      --qhr-color-primary-700: #7E5C38;
      --qhr-color-accent: #987146;
      --qhr-color-accent-fg: #050505;
      --qhr-color-luxury-gold: #987146;
      --qhr-ring-focus: rgba(152, 113, 70, 0.55);

      /* On dark surfaces the action colour is bronze */
      --qhr-button-primary-background: #987146;
      --qhr-button-primary-foreground: #050505;
      --qhr-button-primary-border: #987146;
      --qhr-button-primary-hover: #A98256;
      --qhr-button-outline-border: #987146;
      --qhr-button-outline-foreground: #F4EFE7;
      --qhr-button-outline-hover: rgba(152, 113, 70, 0.20);
      --qhr-button-ghost-foreground: #D9BF97;
      --qhr-button-ghost-hover: rgba(152, 113, 70, 0.16);
      --qhr-color-secondary: #1A2535;
      --qhr-color-secondary-hover: #243247;
      --qhr-color-secondary-fg: #F4EFE7;

      --qhr-shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.35);
      --qhr-shadow-md: 0 8px 20px -8px rgba(0, 0, 0, 0.55);
      --qhr-shadow-lg: 0 14px 32px -10px rgba(0, 0, 0, 0.6);
      --qhr-shadow-xl: 0 22px 44px -14px rgba(0, 0, 0, 0.7);
    }

    [data-theme="downtown"][data-mode="light"] {
      /* Clean white surfaces */
      --qhr-surface-base: #FFFFFF;
      --qhr-surface-page: #FFFFFF;
      --qhr-surface-elevated: #FFFFFF;
      --qhr-surface-card: #FFFFFF;
      --qhr-surface-muted: #F4F1EC;
      --qhr-surface-subtle: #F8F6F2;
      --qhr-color-bg: #FFFFFF;
      --qhr-color-surface: #FFFFFF;
      --qhr-color-surface-elevated: #F4F1EC;

      --qhr-content-primary: #0E1622;
      --qhr-content-secondary: #44505E;
      --qhr-content-muted: #5E6874;
      --qhr-text-primary: #0E1622;
      --qhr-text-secondary: #44505E;
      --qhr-text-muted: #5E6874;
      --qhr-color-text-primary: #0E1622;
      --qhr-color-text-secondary: #44505E;
      --qhr-color-text-muted: #5E6874;

      --qhr-border-subtle: #E7E2D9;
      --qhr-border-strong: #CBBFAE;
      --qhr-color-border: #DDD6CA;
      --qhr-color-border-subtle: #E7E2D9;
      --qhr-color-border-strong: #CBBFAE;

      --qhr-color-primary: #0E1622;
      --qhr-color-primary-bg: #0E1622;
      --qhr-color-primary-fg: #FFFFFF;
      --qhr-color-primary-hover: #1C2838;
      --qhr-color-primary-subtle: rgba(14, 22, 34, 0.06);
      --qhr-color-primary-border: #0E1622;
      --qhr-color-primary-focus: rgba(14, 22, 34, 0.25);
      --qhr-color-primary-base: #987146;
      --qhr-color-primary-400: #987146;
      --qhr-color-primary-500: #987146;
      --qhr-color-primary-600: #0E1622;
      --qhr-color-primary-700: #1C2838;
      --qhr-color-accent: #987146;
      --qhr-color-accent-fg: #050505;
      --qhr-color-luxury-gold: #987146;

      /* On white surfaces the action colour is navy */
      --qhr-button-primary-background: #0E1622;
      --qhr-button-primary-foreground: #FFFFFF;
      --qhr-button-primary-border: #0E1622;
      --qhr-button-primary-hover: #1C2838;
      --qhr-button-outline-border: #0E1622;
      --qhr-button-outline-foreground: #0E1622;
      --qhr-button-outline-hover: rgba(14, 22, 34, 0.06);
      --qhr-button-ghost-foreground: #0E1622;
      --qhr-button-ghost-hover: rgba(152, 113, 70, 0.12);
      --qhr-color-secondary: #F4F1EC;
      --qhr-color-secondary-hover: #E7E2D9;
      --qhr-color-secondary-fg: #0E1622;

      --qhr-shadow-sm: 0 1px 2px rgba(14, 22, 34, 0.06);
      --qhr-shadow-md: 0 8px 20px -10px rgba(14, 22, 34, 0.25);
      --qhr-shadow-lg: 0 14px 30px -12px rgba(14, 22, 34, 0.28);
      --qhr-shadow-xl: 0 22px 44px -16px rgba(14, 22, 34, 0.35);
    }
  </style>

  <script>
    /* Bilingual copy + page state (Alpine.js). Arabic is the default and is also written
       directly in the HTML so the page reads correctly before/without JavaScript. */
    function uidcPage() {
      const copy = {
        ar: {
          'meta.title': 'شركة الانطباع الفريد للديكور | UIDC',
          'nav.label': 'التنقل الرئيسي', 'nav.home': 'الرئيسية', 'nav.services': 'خدماتنا', 'nav.projects': 'مشاريعنا', 'nav.team': 'فريقنا', 'nav.contact': 'تواصل معنا',
          'nav.menu': 'فتح القائمة', 'nav.cta': 'اطلب استشارة', 'lang.switch': 'English', 'lang.aria': 'Switch to English', 'brand.home': 'UIDC — الصفحة الرئيسية',
          'hero.kicker': 'تصميم داخلي · ديكورات خشبية · أبواب فاخرة',
          'hero.title.a': 'انطباعٌ فريد', 'hero.title.b': 'يبدأ من أدق التفاصيل',
          'hero.lead': 'شركة الانطباع الفريد للديكور في الرياض. نصمّم المساحات الداخلية وننفّذ الديكورات الخشبية والأبواب الفاخرة، من الفكرة الأولى حتى التسليم.',
          'hero.cta1': 'اطلب استشارة', 'hero.cta2': 'شاهد أعمالنا', 'hero.img': 'تصميم مجلس داخلي فاخر من شركة الانطباع الفريد',
          'srv.kicker': 'خدماتنا', 'srv.title': 'ثلاث خبرات تحت سقف واحد', 'srv.desc': 'نعمل على المشروع كاملاً: التصميم، التصنيع، والتركيب، بفريق واحد ومسؤولية واحدة.',
          'srv.1.t': 'التصميم الداخلي', 'srv.1.d': 'مخططات توزيع وتصورات ثلاثية الأبعاد واختيار للمواد والإضاءة تعكس ذوقك وطبيعة استخدامك للمكان.',
          'srv.2.t': 'الديكورات الخشبية', 'srv.2.d': 'تجاليد جدارية وأسقف ووحدات تلفزيون ومكتبات وخزائن مدمجة، تُصنع حسب المقاس وبتشطيبات مختارة.',
          'srv.3.t': 'الأبواب الفاخرة', 'srv.3.d': 'أبواب رئيسية وداخلية بتصاميم كلاسيكية وعصرية، مع المقابض والإكسسوارات والتركيب والضبط.',
          'srv.more': 'تفاصيل الخدمة', 'srv.verified': 'خدمة معتمدة',
          'acc.title': 'ماذا تشمل خدماتنا؟',
          'acc.1.t': 'التصميم الداخلي', 'acc.1.s': 'من دراسة المساحة إلى الإشراف', 'acc.1.b': 'زيارة الموقع وأخذ المقاسات، مخطط توزيع الأثاث، تصورات ثلاثية الأبعاد، لوحة المواد والألوان والإضاءة، ثم متابعة التنفيذ حتى يطابق الواقع التصميم.',
          'acc.2.t': 'الديكورات الخشبية', 'acc.2.s': 'تصنيع حسب المقاس', 'acc.2.b': 'تجاليد الجدران، الأسقف الخشبية، وحدات التلفزيون، المكتبات، غرف الملابس والخزائن المدمجة، مع اختيار نوع الخشب والقشرة واللون والتشطيب.',
          'acc.3.t': 'الأبواب الفاخرة', 'acc.3.s': 'رئيسية وداخلية', 'acc.3.b': 'أبواب خشبية بتصاميم كلاسيكية وحديثة، حلوق وبراويز متناسقة، مقابض وإكسسوارات، وتركيب دقيق وضبط نهائي بعد التركيب.',
          'acc.4.t': 'كيف نبدأ مشروعك؟', 'acc.4.s': 'أربع خطوات واضحة', 'acc.4.b': 'تواصل معنا، ثم زيارة وقياس، ثم تصميم وعرض سعر مفصّل، ثم التنفيذ والتسليم.',
          'prj.kicker': 'مشاريعنا', 'prj.title': 'أعمال تتحدث عن نفسها', 'prj.desc': 'نماذج من المساحات والمشاريع التي صممناها ونفذناها بأعلى معايير الإتقان المعماري.',
          'prj.carousel': 'معرض المشاريع', 'prj.prev': 'المشروع السابق', 'prj.next': 'المشروع التالي', 'prj.goto': 'عرض المشروع رقم', 'prj.slide': 'من', 'prj.badge': 'مشروع منجز',
          'prj.1.c': 'تصميم داخلي', 'prj.1.t': 'جناح نوم رئيسي', 'prj.1.s': 'الرياض · تنفيذ متكامل',
          'prj.2.c': 'ديكورات خشبية', 'prj.2.t': 'صالة معيشة مفتوحة', 'prj.2.s': 'الرياض · تكسيات جدارية',
          'prj.3.c': 'تصميم داخلي', 'prj.3.t': 'مجلس عائلي', 'prj.3.s': 'الرياض · تصميم فندقي',
          'prj.4.c': 'أبواب وتجاليد', 'prj.4.t': 'معيشة عصرية', 'prj.4.s': 'الرياض · تفصيل خاص',
          'team.kicker': 'فريقنا', 'team.title': 'تحدّث مباشرة مع فريقنا', 'team.desc': 'فريق المبيعات يرافقك من أول اتصال: يفهم احتياجك، ويرتّب زيارة الموقع، ويقدّم لك عرض السعر.',
          'team.cta': 'تواصل معنا',
          'card.company': 'شركة الانطباع الفريد للديكور', 'card.qr': 'امسح الرمز لحفظ جهة الاتصال', 'card.qr.alt': 'رمز QR الرسمي لبطاقة وجيه راشد',
          'card.name': 'وجيه راشد', 'card.role': 'مدير مبيعات', 'card.phone': 'الجوال', 'card.email': 'البريد', 'card.call': 'اتصال', 'card.wa': 'واتساب',
          'ft.tagline': 'تصميم داخلي · ديكورات خشبية · أبواب فاخرة',
          'ft.address.t': 'العنوان', 'ft.address': 'المملكة العربية السعودية - الرياض - شارع اسطنبول - السلي',
          'ft.contact.t': 'التواصل', 'ft.unified': 'المبيعات والاستشارات', 'ft.wa': 'واتساب', 'ft.mobile': 'الجوال', 'ft.email': 'البريد',
          'ft.links.t': 'روابط سريعة', 'ft.rights': 'جميع الحقوق محفوظة لشركة الانطباع الفريد للديكور'
        },
        en: {
          'meta.title': 'Unique Impression for Decoration | UIDC',
          'nav.label': 'Main navigation', 'nav.home': 'Home', 'nav.services': 'Services', 'nav.projects': 'Projects', 'nav.team': 'Team', 'nav.contact': 'Contact',
          'nav.menu': 'Open menu', 'nav.cta': 'Request a consultation', 'lang.switch': 'العربية', 'lang.aria': 'التبديل إلى العربية', 'brand.home': 'UIDC — Home',
          'hero.kicker': 'Interior design · Wooden decor · Luxury doors',
          'hero.title.a': 'A unique impression,', 'hero.title.b': 'crafted in every detail',
          'hero.lead': 'Unique Impression for Decoration, Riyadh. We design interiors and build wooden decor and luxury doors, from the first idea to handover.',
          'hero.cta1': 'Request a consultation', 'hero.cta2': 'View our work', 'hero.img': 'Luxury living-room design by Unique Impression for Decoration',
          'srv.kicker': 'Services', 'srv.title': 'Three crafts under one roof', 'srv.desc': 'We handle the whole project: design, fabrication and installation, with one team and one point of responsibility.',
          'srv.1.t': 'Interior design', 'srv.1.d': 'Space plans, 3D visualisations and a curated selection of materials and lighting that fit your taste and the way you live.',
          'srv.2.t': 'Wooden decor', 'srv.2.d': 'Wall panelling, ceilings, TV units, bookcases and built-in wardrobes, made to measure with the finish you choose.',
          'srv.3.t': 'Luxury doors', 'srv.3.d': 'Main and interior doors in classic and contemporary designs, with handles, hardware, installation and final adjustment.',
          'srv.more': 'Service details', 'srv.verified': 'Certified Service',
          'acc.title': 'What our services include',
          'acc.1.t': 'Interior design', 'acc.1.s': 'From site study to supervision', 'acc.1.b': 'Site visit and measurements, furniture layout, 3D visualisations, a materials, colour and lighting board, then follow-up on site until the result matches the design.',
          'acc.2.t': 'Wooden decor', 'acc.2.s': 'Made to measure', 'acc.2.b': 'Wall panelling, wooden ceilings, TV units, bookcases, dressing rooms and built-in wardrobes, with your choice of wood, veneer, colour and finish.',
          'acc.3.t': 'Luxury doors', 'acc.3.s': 'Main and interior', 'acc.3.b': 'Wooden doors in classic and modern designs, matching frames and architraves, handles and hardware, precise installation and final adjustment.',
          'acc.4.t': 'How do we start?', 'acc.4.s': 'Four clear steps', 'acc.4.b': 'Contact us, then a site visit and measurements, then design and a detailed quotation, then fabrication, installation and handover.',
          'prj.kicker': 'Projects', 'prj.title': 'Work that speaks for itself', 'prj.desc': 'A selection of spaces we designed and built to the highest architectural standards.',
          'prj.carousel': 'Project gallery', 'prj.prev': 'Previous project', 'prj.next': 'Next project', 'prj.goto': 'Show project', 'prj.slide': 'of', 'prj.badge': 'Completed Project',
          'prj.1.c': 'Interior design', 'prj.1.t': 'Master bedroom suite', 'prj.1.s': 'Riyadh · Full Execution',
          'prj.2.c': 'Wooden decor', 'prj.2.t': 'Open-plan living room', 'prj.2.s': 'Riyadh · Wall Panelling',
          'prj.3.c': 'Interior design', 'prj.3.t': 'Family majlis', 'prj.3.s': 'Riyadh · Hotel Standard',
          'prj.4.c': 'Doors & panelling', 'prj.4.t': 'Contemporary living', 'prj.4.s': 'Riyadh · Custom Built',
          'team.kicker': 'Team', 'team.title': 'Talk directly to our team', 'team.desc': 'Our sales team is with you from the first call: understanding your needs, arranging the site visit and preparing your quotation.',
          'team.cta': 'Contact us',
          'card.company': 'Unique Impression for Decoration', 'card.qr': 'Scan to save the contact', 'card.qr.alt': 'Official QR code for Wageh Rashed',
          'card.name': 'Wageh Rashed', 'card.role': 'Sales Manager', 'card.phone': 'Mobile', 'card.email': 'Email', 'card.call': 'Call', 'card.wa': 'WhatsApp',
          'ft.tagline': 'Interior design · Wooden decor · Luxury doors',
          'ft.address.t': 'Address', 'ft.address': 'Saudi Arabia - Riyadh - Istanbul St - Al Sulay',
          'ft.contact.t': 'Contact', 'ft.unified': 'Sales & Consultations', 'ft.wa': 'WhatsApp', 'ft.mobile': 'Mobile', 'ft.email': 'Email',
          'ft.links.t': 'Quick links', 'ft.rights': 'All rights reserved, Unique Impression for Decoration'
        }
      };
      let saved = 'ar';
      try { saved = localStorage.getItem('uidc-lang') === 'en' ? 'en' : 'ar'; } catch (e) {}
      return {
        lang: saved,
        navOpen: false,
        year: 2026,
        get dir() { return this.lang === 'ar' ? 'rtl' : 'ltr'; },
        t(key) { return (copy[this.lang] && copy[this.lang][key]) || copy.ar[key] || key; },
        toggleLang() {
          this.lang = this.lang === 'ar' ? 'en' : 'ar';
          try { localStorage.setItem('uidc-lang', this.lang); } catch (e) {}
        },
        applyLang() {
          document.documentElement.lang = this.lang;
          document.documentElement.dir = this.dir;
          document.title = this.t('meta.title');
        }
      };
    }
  </script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>
</head>

<body x-data="uidcPage()" x-effect="applyLang()" @keydown.escape.window="navOpen = false">

  <!-- Qahera icon sprite (Hidden cleanly without layout shift) -->
  <svg style="display: none; position: absolute; width: 0; height: 0;" aria-hidden="true" focusable="false">
    <symbol id="qhr-icon-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h16" /></symbol>
    <symbol id="qhr-icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18L18 6M6 6l12 12" /></symbol>
    <symbol id="qhr-icon-chevron-down" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 9l-7 7-7-7" /></symbol>
    <symbol id="qhr-icon-chevron-left" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 19l-7-7 7-7" /></symbol>
    <symbol id="qhr-icon-chevron-right" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7" /></symbol>
    <symbol id="qhr-icon-arrow-start" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5m7 7l-7-7 7-7" /></symbol>
    <symbol id="qhr-icon-arrow-end" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-7 7l7-7-7-7" /></symbol>
    <symbol id="qhr-icon-external-link" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6m4-3h6v6m-11 5L21 3" /></symbol>
    <symbol id="qhr-icon-image" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></symbol>
    <symbol id="qhr-icon-user" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></symbol>
    <symbol id="qhr-icon-link" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></symbol>
  </svg>

  <!-- ============ 1. Navbar (Qahera Navbar component) ============ -->
  <header class="qhr-navbar qhr-navbar--tone-gold" :class="{ 'is-open': navOpen }">
    <nav class="qhr-navbar-container" aria-label="التنقل الرئيسي" :aria-label="t('nav.label')">
      <a href="#top" class="qhr-navbar-brand" aria-label="UIDC — الصفحة الرئيسية" :aria-label="t('brand.home')">
        <img src="logo.png" alt="" width="40" height="42">
        <span lang="en">UIDC</span>
      </a>

      <ul class="qhr-navbar-links">
        <li><a href="#top" class="qhr-navbar-link is-active" aria-current="page" x-text="t('nav.home')">الرئيسية</a></li>
        <li><a href="#services" class="qhr-navbar-link" x-text="t('nav.services')">خدماتنا</a></li>
        <li><a href="#projects" class="qhr-navbar-link" x-text="t('nav.projects')">مشاريعنا</a></li>
        <li><a href="#team" class="qhr-navbar-link" x-text="t('nav.team')">فريقنا</a></li>
        <li><a href="#contact" class="qhr-navbar-link" x-text="t('nav.contact')">تواصل معنا</a></li>
      </ul>

      <div class="qhr-navbar-actions">
        <button type="button" class="qhr-btn qhr-btn--outline qhr-btn--sm" @click="toggleLang()"
                lang="en" :lang="lang === 'ar' ? 'en' : 'ar'"
                aria-label="Switch to English" :aria-label="t('lang.aria')" x-text="t('lang.switch')">English</button>
        <a href="#contact" class="qhr-btn qhr-btn--primary qhr-btn--sm" x-text="t('nav.cta')">اطلب استشارة</a>
        <button type="button" class="qhr-navbar-toggle" @click="navOpen = !navOpen"
                aria-controls="uidc-mobile-nav" :aria-expanded="navOpen.toString()" aria-expanded="false"
                aria-label="فتح القائمة" :aria-label="t('nav.menu')">
          <svg class="qhr-icon" width="22" height="22" aria-hidden="true"><use href="#qhr-icon-menu" :href="navOpen ? '#qhr-icon-close' : '#qhr-icon-menu'"></use></svg>
        </button>
      </div>
    </nav>

    <div class="qhr-navbar-collapse" id="uidc-mobile-nav">
      <ul class="qhr-navbar-links" @click="navOpen = false">
        <li><a href="#top" class="qhr-navbar-link" x-text="t('nav.home')">الرئيسية</a></li>
        <li><a href="#services" class="qhr-navbar-link" x-text="t('nav.services')">خدماتنا</a></li>
        <li><a href="#projects" class="qhr-navbar-link" x-text="t('nav.projects')">مشاريعنا</a></li>
        <li><a href="#team" class="qhr-navbar-link" x-text="t('nav.team')">فريقنا</a></li>
        <li><a href="#contact" class="qhr-navbar-link" x-text="t('nav.contact')">تواصل معنا</a></li>
      </ul>
    </div>
  </header>

  <main id="top">

    <!-- ============ 2. Hero — HeroSkylinePanorama pattern (built on the kit's qhr-hero--cinematic primitives) ============ -->
    <section class="qhr-hero qhr-hero--cinematic" aria-labelledby="hero-title">
      <div class="qhr-hero-canvas">
        <img class="qhr-hero-canvas-img" src="images/placeholder-hero.jpg" width="1600" height="844"
             alt="تصميم مجلس داخلي فاخر من شركة الانطباع الفريد" :alt="t('hero.img')" fetchpriority="high">
      </div>
      <div class="qhr-hero-scrim" aria-hidden="true"></div>

      <div class="qhr-hero-container">
        <div class="qhr-hero-grid">
          <div class="qhr-hero-dossier">
            <p><span class="qhr-badge qhr-badge--accent" x-text="t('hero.kicker')">تصميم داخلي · ديكورات خشبية · أبواب فاخرة</span></p>
            <h1 class="qhr-hero-title" id="hero-title">
              <span x-text="t('hero.title.a')">انطباعٌ فريد</span><br>
              <span class="qhr-text--accent" x-text="t('hero.title.b')">يبدأ من أدق التفاصيل</span>
            </h1>
            <p class="qhr-hero-lead" x-text="t('hero.lead')">شركة الانطباع الفريد للديكور في الرياض. نصمّم المساحات الداخلية وننفّذ الديكورات الخشبية والأبواب الفاخرة، من الفكرة الأولى حتى التسليم.</p>
            <div class="qhr-hero-actions">
              <a href="#contact" class="qhr-btn qhr-btn--primary qhr-btn--lg">
                <span x-text="t('hero.cta1')">اطلب استشارة</span>
                <svg class="qhr-icon" width="20" height="20" aria-hidden="true"><use href="#qhr-icon-arrow-start" :href="dir === 'rtl' ? '#qhr-icon-arrow-start' : '#qhr-icon-arrow-end'"></use></svg>
              </a>
              <a href="#projects" class="qhr-btn qhr-btn--outline qhr-btn--lg" x-text="t('hero.cta2')">شاهد أعمالنا</a>
            </div>
          </div>
          <div class="qhr-hero-focal-void" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    <!-- ============ 3. Services — Card + Accordion (white surface) ============ -->
    <section id="services" class="qhr-box" data-theme="downtown" data-mode="light" aria-labelledby="services-title">
      <div class="qhr-box-body">
      <div class="qhr-showcase-container">
        <div class="qhr-showcase-section">
          <header class="qhr-showcase-section-header">
            <p><span class="qhr-badge qhr-badge--accent" x-text="t('srv.kicker')">خدماتنا</span></p>
            <h2 id="services-title" x-text="t('srv.title')">ثلاث خبرات تحت سقف واحد</h2>
            <p class="qhr-showcase-section-desc" x-text="t('srv.desc')">نعمل على المشروع كاملاً: التصميم، التصنيع، والتركيب، بفريق واحد ومسؤولية واحدة.</p>
          </header>

          <div class="qhr-showcase-grid-3">
            <article class="qhr-card qhr-card--outline qhr-card--interactive" aria-labelledby="srv-1">
              <div class="qhr-card-media">
                <img src="images/placeholder-service-interior.jpg" width="1200" height="900" loading="lazy"
                     alt="تصميم داخلي معتمد" :alt="t('srv.1.t')">
              </div>
              <div class="qhr-card-body">
                <h3 class="qhr-card-title" id="srv-1" x-text="t('srv.1.t')">التصميم الداخلي</h3>
                <p class="qhr-card-text" x-text="t('srv.1.d')">مخططات توزيع وتصورات ثلاثية الأبعاد واختيار للمواد والإضاءة تعكس ذوقك وطبيعة استخدامك للمكان.</p>
              </div>
              <div class="qhr-card-footer">
                <a href="#service-details" class="qhr-btn qhr-btn--ghost qhr-btn--sm" @click="$dispatch('open-service', 'interior')" x-text="t('srv.more')">تفاصيل الخدمة</a>
                <span class="qhr-badge qhr-badge--accent" x-text="t('srv.verified')">خدمة معتمدة</span>
              </div>
            </article>

            <article class="qhr-card qhr-card--outline qhr-card--interactive" aria-labelledby="srv-2">
              <div class="qhr-card-media">
                <img src="images/placeholder-service-wood.jpg" width="1450" height="1088" loading="lazy"
                     alt="الديكورات الخشبية والكسوات" :alt="t('srv.2.t')">
              </div>
              <div class="qhr-card-body">
                <h3 class="qhr-card-title" id="srv-2" x-text="t('srv.2.t')">الديكورات الخشبية</h3>
                <p class="qhr-card-text" x-text="t('srv.2.d')">تجاليد جدارية وأسقف ووحدات تلفزيون ومكتبات وخزائن مدمجة، تُصنع حسب المقاس وبتشطيبات مختارة.</p>
              </div>
              <div class="qhr-card-footer">
                <a href="#service-details" class="qhr-btn qhr-btn--ghost qhr-btn--sm" @click="$dispatch('open-service', 'wood')" x-text="t('srv.more')">تفاصيل الخدمة</a>
                <span class="qhr-badge qhr-badge--accent" x-text="t('srv.verified')">خدمة معتمدة</span>
              </div>
            </article>

            <article class="qhr-card qhr-card--outline qhr-card--interactive" aria-labelledby="srv-3">
              <div class="qhr-card-media">
                <img src="images/placeholder-service-doors.jpg" width="1600" height="1200" loading="lazy"
                     alt="الأبواب الفاخرة والفندقية" :alt="t('srv.3.t')">
              </div>
              <div class="qhr-card-body">
                <h3 class="qhr-card-title" id="srv-3" x-text="t('srv.3.t')">الأبواب الفاخرة</h3>
                <p class="qhr-card-text" x-text="t('srv.3.d')">أبواب رئيسية وداخلية بتصاميم كلاسيكية وعصرية، مع المقابض والإكسسوارات والتركيب والضبط.</p>
              </div>
              <div class="qhr-card-footer">
                <a href="#service-details" class="qhr-btn qhr-btn--ghost qhr-btn--sm" @click="$dispatch('open-service', 'doors')" x-text="t('srv.more')">تفاصيل الخدمة</a>
                <span class="qhr-badge qhr-badge--accent" x-text="t('srv.verified')">خدمة معتمدة</span>
              </div>
            </article>
          </div>
        </div>

        <div class="qhr-showcase-section" id="service-details">
          <header class="qhr-showcase-section-header">
            <h3 x-text="t('acc.title')">ماذا تشمل خدماتنا؟</h3>
          </header>

          <div class="qhr-accordion qhr-accordion--separate"
               x-data="{ open: 'interior', isOpen(id) { return this.open === id; }, toggle(id) { this.open = this.open === id ? null : id; } }"
               @open-service.window="open = $event.detail">

            <div class="qhr-accordion-item" :class="{ 'is-open': isOpen('interior') }">
              <h4>
                <button type="button" class="qhr-accordion-trigger" id="acc-t-1" aria-controls="acc-p-1" :aria-expanded="isOpen('interior').toString()" @click="toggle('interior')">
                  <span class="qhr-accordion-content-meta">
                    <span class="qhr-accordion-title" x-text="t('acc.1.t')">التصميم الداخلي</span>
                    <span class="qhr-accordion-subtitle" x-text="t('acc.1.s')">من دراسة المساحة إلى الإشراف</span>
                  </span>
                  <svg class="qhr-icon qhr-accordion-icon" width="18" height="18" aria-hidden="true"><use href="#qhr-icon-chevron-down"></use></svg>
                </button>
              </h4>
              <div class="qhr-accordion-content" id="acc-p-1" role="region" aria-labelledby="acc-t-1" x-show="isOpen('interior')">
                <div class="qhr-accordion-body" x-text="t('acc.1.b')">زيارة الموقع وأخذ المقاسات، مخطط توزيع الأثاث، تصورات ثلاثية الأبعاد، لوحة المواد والألوان والإضاءة، ثم متابعة التنفيذ حتى يطابق الواقع التصميم.</div>
              </div>
            </div>

            <div class="qhr-accordion-item" :class="{ 'is-open': isOpen('wood') }">
              <h4>
                <button type="button" class="qhr-accordion-trigger" id="acc-t-2" aria-controls="acc-p-2" :aria-expanded="isOpen('wood').toString()" @click="toggle('wood')">
                  <span class="qhr-accordion-content-meta">
                    <span class="qhr-accordion-title" x-text="t('acc.2.t')">الديكورات الخشبية</span>
                    <span class="qhr-accordion-subtitle" x-text="t('acc.2.s')">تصنيع حسب المقاس</span>
                  </span>
                  <svg class="qhr-icon qhr-accordion-icon" width="18" height="18" aria-hidden="true"><use href="#qhr-icon-chevron-down"></use></svg>
                </button>
              </h4>
              <div class="qhr-accordion-content" id="acc-p-2" role="region" aria-labelledby="acc-t-2" x-show="isOpen('wood')">
                <div class="qhr-accordion-body" x-text="t('acc.2.b')">تجاليد الجدران، الأسقف الخشبية، وحدات التلفزيون، المكتبات، غرف الملابس والخزائن المدمجة، مع اختيار نوع الخشب والقشرة واللون والتشطيب.</div>
              </div>
            </div>

            <div class="qhr-accordion-item" :class="{ 'is-open': isOpen('doors') }">
              <h4>
                <button type="button" class="qhr-accordion-trigger" id="acc-t-3" aria-controls="acc-p-3" :aria-expanded="isOpen('doors').toString()" @click="toggle('doors')">
                  <span class="qhr-accordion-content-meta">
                    <span class="qhr-accordion-title" x-text="t('acc.3.t')">الأبواب الفاخرة</span>
                    <span class="qhr-accordion-subtitle" x-text="t('acc.3.s')">رئيسية وداخلية</span>
                  </span>
                  <svg class="qhr-icon qhr-accordion-icon" width="18" height="18" aria-hidden="true"><use href="#qhr-icon-chevron-down"></use></svg>
                </button>
              </h4>
              <div class="qhr-accordion-content" id="acc-p-3" role="region" aria-labelledby="acc-t-3" x-show="isOpen('doors')">
                <div class="qhr-accordion-body" x-text="t('acc.3.b')">أبواب خشبية بتصاميم كلاسيكية وحديثة، حلوق وبراويز متناسقة، مقابض وإكسسوارات، وتركيب دقيق وضبط نهائي بعد التركيب.</div>
              </div>
            </div>

            <div class="qhr-accordion-item" :class="{ 'is-open': isOpen('steps') }">
              <h4>
                <button type="button" class="qhr-accordion-trigger" id="acc-t-4" aria-controls="acc-p-4" :aria-expanded="isOpen('steps').toString()" @click="toggle('steps')">
                  <span class="qhr-accordion-content-meta">
                    <span class="qhr-accordion-title" x-text="t('acc.4.t')">كيف نبدأ مشروعك؟</span>
                    <span class="qhr-accordion-subtitle" x-text="t('acc.4.s')">أربع خطوات واضحة</span>
                  </span>
                  <svg class="qhr-icon qhr-accordion-icon" width="18" height="18" aria-hidden="true"><use href="#qhr-icon-chevron-down"></use></svg>
                </button>
              </h4>
              <div class="qhr-accordion-content" id="acc-p-4" role="region" aria-labelledby="acc-t-4" x-show="isOpen('steps')">
                <div class="qhr-accordion-body" x-text="t('acc.4.b')">تواصل معنا، ثم زيارة وقياس، ثم تصميم وعرض سعر مفصّل، ثم التنفيذ والتسليم.</div>
              </div>
            </div>

          </div>
        </div>
      </div>
      </div>
    </section>

    <!-- ============ 4. Projects — Carousel + LuxuryProductCard composition (dark obsidian) ============ -->
    <section id="projects" aria-labelledby="projects-title">
      <div class="qhr-showcase-container">
        <div class="qhr-showcase-section">
          <header class="qhr-showcase-section-header">
            <p><span class="qhr-badge qhr-badge--accent" x-text="t('prj.kicker')">مشاريعنا</span></p>
            <h2 id="projects-title" x-text="t('prj.title')">أعمال تتحدث عن نفسها</h2>
            <p class="qhr-showcase-section-desc" x-text="t('prj.desc')">نماذج من المساحات التي صممناها ونفذناها. الصور الحالية توضيحية مؤقتة.</p>
          </header>

          <div class="qhr-carousel" role="region" aria-roledescription="carousel"
               aria-label="معرض المشاريع" :aria-label="t('prj.carousel')" tabindex="0"
               x-data="{
                 active: 0, count: 4, startX: null,
                 prev() { this.active = (this.active + this.count - 1) % this.count; },
                 next() { this.active = (this.active + 1) % this.count; },
                 swipe(endX) {
                   if (this.startX === null) return;
                   const dx = endX - this.startX;
                   this.startX = null;
                   if (Math.abs(dx) < 40) return;
                   const isRtl = (document.documentElement.dir || 'rtl') === 'rtl';
                   const forward = isRtl ? dx > 0 : dx < 0;
                   forward ? this.next() : this.prev();
                 }
               }"
               @keydown.right.prevent="(document.documentElement.dir || 'rtl') === 'rtl' ? prev() : next()"
               @keydown.left.prevent="(document.documentElement.dir || 'rtl') === 'rtl' ? next() : prev()"
               @touchstart.passive="startX = $event.changedTouches[0].clientX"
               @touchend="swipe($event.changedTouches[0].clientX)">

            <div class="qhr-carousel-track" aria-live="polite" :style="`transform: translateX(${((document.documentElement.dir || 'rtl') === 'rtl' ? 1 : -1) * active * 100}%)`">

              <div class="qhr-carousel-slide" role="group" aria-roledescription="slide" aria-label="1 / 4" :aria-hidden="(active !== 0).toString()" :inert="active !== 0">
                <article class="qhr-card">
                  <div class="qhr-card-media">
                    <img src="images/placeholder-project-1.jpg" width="1600" height="900" loading="lazy" alt="جناح نوم رئيسي" :alt="t('prj.1.t')">
                  </div>
                  <div class="qhr-card-body">
                    <p><span class="qhr-badge qhr-badge--accent" x-text="t('prj.1.c')">تصميم داخلي</span></p>
                    <h3 class="qhr-card-title" x-text="t('prj.1.t')">جناح نوم رئيسي</h3>
                    <p class="qhr-card-text" x-text="t('prj.1.s')">الرياض · تنفيذ متكامل</p>
                  </div>
                  <div class="qhr-card-footer">
                    <span class="qhr-badge qhr-badge--accent" x-text="t('prj.badge')">مشروع منجز</span>
                  </div>
                </article>
              </div>

              <div class="qhr-carousel-slide" role="group" aria-roledescription="slide" aria-label="2 / 4" aria-hidden="true" :aria-hidden="(active !== 1).toString()" :inert="active !== 1">
                <article class="qhr-card">
                  <div class="qhr-card-media">
                    <img src="images/placeholder-project-2.jpg" width="1600" height="900" loading="lazy" alt="صالة معيشة مفتوحة" :alt="t('prj.2.t')">
                  </div>
                  <div class="qhr-card-body">
                    <p><span class="qhr-badge qhr-badge--accent" x-text="t('prj.2.c')">ديكورات خشبية</span></p>
                    <h3 class="qhr-card-title" x-text="t('prj.2.t')">صالة معيشة مفتوحة</h3>
                    <p class="qhr-card-text" x-text="t('prj.2.s')">الرياض · تكسيات جدارية</p>
                  </div>
                  <div class="qhr-card-footer">
                    <span class="qhr-badge qhr-badge--accent" x-text="t('prj.badge')">مشروع منجز</span>
                  </div>
                </article>
              </div>

              <div class="qhr-carousel-slide" role="group" aria-roledescription="slide" aria-label="3 / 4" aria-hidden="true" :aria-hidden="(active !== 2).toString()" :inert="active !== 2">
                <article class="qhr-card">
                  <div class="qhr-card-media">
                    <img src="images/placeholder-project-3.jpg" width="1600" height="900" loading="lazy" alt="مجلس عائلي" :alt="t('prj.3.t')">
                  </div>
                  <div class="qhr-card-body">
                    <p><span class="qhr-badge qhr-badge--accent" x-text="t('prj.3.c')">تصميم داخلي</span></p>
                    <h3 class="qhr-card-title" x-text="t('prj.3.t')">مجلس عائلي</h3>
                    <p class="qhr-card-text" x-text="t('prj.3.s')">الرياض · تصميم فندقي</p>
                  </div>
                  <div class="qhr-card-footer">
                    <span class="qhr-badge qhr-badge--accent" x-text="t('prj.badge')">مشروع منجز</span>
                  </div>
                </article>
              </div>

              <div class="qhr-carousel-slide" role="group" aria-roledescription="slide" aria-label="4 / 4" aria-hidden="true" :aria-hidden="(active !== 3).toString()" :inert="active !== 3">
                <article class="qhr-card">
                  <div class="qhr-card-media">
                    <img src="images/placeholder-project-4.jpg" width="1600" height="900" loading="lazy" alt="معيشة عصرية" :alt="t('prj.4.t')">
                  </div>
                  <div class="qhr-card-body">
                    <p><span class="qhr-badge qhr-badge--accent" x-text="t('prj.4.c')">أبواب وتجاليد</span></p>
                    <h3 class="qhr-card-title" x-text="t('prj.4.t')">معيشة عصرية</h3>
                    <p class="qhr-card-text" x-text="t('prj.4.s')">الرياض · تفصيل خاص</p>
                  </div>
                  <div class="qhr-card-footer">
                    <span class="qhr-badge qhr-badge--accent" x-text="t('prj.badge')">مشروع منجز</span>
                  </div>
                </article>
              </div>
            </div>

            <button type="button" class="qhr-carousel-control qhr-carousel-control--prev" @click="prev()" aria-label="المشروع السابق" :aria-label="t('prj.prev')">
              <svg class="qhr-icon" width="18" height="18" aria-hidden="true"><use href="#qhr-icon-chevron-right" :href="dir === 'rtl' ? '#qhr-icon-chevron-right' : '#qhr-icon-chevron-left'"></use></svg>
            </button>
            <button type="button" class="qhr-carousel-control qhr-carousel-control--next" @click="next()" aria-label="المشروع التالي" :aria-label="t('prj.next')">
              <svg class="qhr-icon" width="18" height="18" aria-hidden="true"><use href="#qhr-icon-chevron-left" :href="dir === 'rtl' ? '#qhr-icon-chevron-left' : '#qhr-icon-chevron-right'"></use></svg>
            </button>

            <div class="qhr-carousel-indicators">
              <template x-for="i in count" :key="i">
                <button type="button" class="qhr-carousel-dot" :class="{ 'is-active': active === i - 1 }" @click="active = i - 1"
                        :aria-label="t('prj.goto') + ' ' + i" :aria-current="active === i - 1 ? 'true' : 'false'"></button>
              </template>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 5. Team — UserCard pattern styled like the UIDC staff card (white surface) ============ -->
    <section id="team" class="qhr-box" data-theme="downtown" data-mode="light" aria-labelledby="team-title">
      <div class="qhr-box-body">
      <div class="qhr-showcase-container">
        <div class="qhr-showcase-section">
          <div class="qhr-showcase-grid-2">
            <header class="qhr-showcase-col-stack">
              <p><span class="qhr-badge qhr-badge--accent" x-text="t('team.kicker')">فريقنا</span></p>
              <h2 id="team-title" x-text="t('team.title')">تحدّث مباشرة مع فريقنا</h2>
              <p class="qhr-showcase-section-desc" x-text="t('team.desc')">فريق المبيعات يرافقك من أول اتصال: يفهم احتياجك، ويرتّب زيارة الموقع، ويقدّم لك عرض السعر.</p>
              <div class="qhr-showcase-flex-wrap">
                <a href="#contact" class="qhr-btn qhr-btn--primary qhr-btn--md" x-text="t('team.cta')">تواصل معنا</a>
              </div>
            </header>

            <!-- Staff card: dark block (logo + QR) meeting the white surface (name, bronze title, contacts) -->
            <div class="qhr-card-group" role="group" aria-label="بطاقة وجيه راشد" :aria-label="t('card.name')">
              <div class="qhr-card" data-theme="downtown">
                <div class="qhr-card-body">
                  <div class="qhr-showcase-col-stack">
                    <img src="logo.png" alt="شعار شركة الانطباع الفريد للديكور" :alt="'UIDC — ' + t('card.company')" width="88" height="92">
                    <p><strong x-text="t('card.company')">شركة الانطباع الفريد للديكور</strong></p>
                    <p class="qhr-card-text" lang="en">Unique Impression for Decoration · UIDC</p>
                  </div>
                </div>
                <div class="qhr-card-footer">
                  <div class="qhr-showcase-col-stack" style="align-items: center; text-align: center;">
                    <img src="images/qr-placeholder-wageh.png" width="120" height="120" loading="lazy"
                         alt="رمز QR الرسمي لبطاقة وجيه راشد" :alt="t('card.qr.alt')">
                    <span class="qhr-card-text" style="font-size: 0.82rem; margin-block-start: 6px;" x-text="t('card.qr')">امسح الرمز لحفظ جهة الاتصال</span>
                  </div>
                </div>
              </div>

              <article class="qhr-card" aria-labelledby="wageh-name">
                <div class="qhr-card-body">
                  <div class="qhr-showcase-col-stack">
                    <span class="qhr-avatar qhr-avatar--xl" aria-hidden="true">
                      <svg class="qhr-icon" width="32" height="32"><use href="#qhr-icon-user"></use></svg>
                    </span>
                    <div>
                      <h3 class="qhr-card-title" id="wageh-name" x-text="t('card.name')">وجيه راشد</h3>
                      <span lang="en" style="display:block; font-size: 0.85rem; color: var(--qhr-color-accent); font-weight: 700; margin-block-start: 2px;">WAGEH RASHED</span>
                    </div>
                    <p><span class="qhr-badge qhr-badge--accent"><span x-text="t('card.role')">مدير مبيعات</span> / Sales Manager</span></p>
                    <div class="qhr-divider qhr-divider--luxury qhr-divider--strong" role="separator"></div>
                    <div>
                      <span class="qhr-card-text" x-text="t('card.phone')">الجوال</span><br>
                      <a href="tel:+966580152223" class="qhr-btn qhr-btn--ghost qhr-btn--sm" dir="ltr">0580152223</a>
                    </div>
                    <div>
                      <span class="qhr-card-text" x-text="t('card.email')">البريد</span><br>
                      <a href="mailto:wageh.rashid@gmail.com" class="qhr-btn qhr-btn--ghost qhr-btn--sm" dir="ltr">wageh.rashid@gmail.com</a>
                    </div>
                  </div>
                </div>
                <div class="qhr-card-footer">
                  <a href="tel:+966580152223" class="qhr-btn qhr-btn--primary qhr-btn--sm" x-text="t('card.call')">اتصال</a>
                  <a href="https://wa.me/966580152223" class="qhr-btn qhr-btn--outline qhr-btn--sm" target="_blank" rel="noopener">
                    <span x-text="t('card.wa')">واتساب</span>
                    <svg class="qhr-icon" width="14" height="14" aria-hidden="true"><use href="#qhr-icon-external-link"></use></svg>
                  </a>
                </div>
              </article>
            </div>
          </div>
        </div>
      </div>
      </div>
    </section>
  </main>

  <!-- ============ 6. Footer — letterhead style (kit has no Footer component; composed from kit primitives) ============ -->
  <footer id="contact" aria-labelledby="footer-title">
    <div class="qhr-showcase-container">
      <div class="qhr-divider qhr-divider--luxury qhr-divider--strong" role="separator">
        <span class="qhr-divider-badge" lang="en">UIDC</span>
      </div>

      <div class="qhr-showcase-grid-3">
        <div class="qhr-showcase-col-stack">
          <a href="#top" class="qhr-navbar-brand" aria-label="UIDC — الصفحة الرئيسية" :aria-label="t('brand.home')">
            <img src="logo.png" alt="" width="56" height="59">
          </a>
          <h2 id="footer-title" x-text="t('card.company')">شركة الانطباع الفريد للديكور</h2>
          <p class="qhr-card-text" x-text="t('ft.tagline')">تصميم داخلي · ديكورات خشبية · أبواب فاخرة</p>
        </div>

        <div class="qhr-showcase-col-stack">
          <h3 x-text="t('ft.address.t')">العنوان</h3>

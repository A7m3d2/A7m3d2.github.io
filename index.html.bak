          <h3 x-text="t('ft.links.t')">روابط سريعة</h3>
          <div class="qhr-showcase-flex-wrap">
            <a href="#services" class="qhr-btn qhr-btn--ghost qhr-btn--sm" x-text="t('nav.services')">خدماتنا</a>
            <a href="#projects" class="qhr-btn qhr-btn--ghost qhr-btn--sm" x-text="t('nav.projects')">مشاريعنا</a>
            <a href="#team" class="qhr-btn qhr-btn--ghost qhr-btn--sm" x-text="t('nav.team')">فريقنا</a>
          </div>
        </div>

        <div class="qhr-showcase-col-stack">
          <h3 x-text="t('ft.contact.t')">التواصل</h3>
          <div><span class="qhr-card-text" x-text="t('ft.unified')">المبيعات والاستشارات</span><br>
             <a href="tel:+966580152223" class="qhr-btn qhr-btn--ghost qhr-btn--sm" dir="ltr">0580152223</a></div>
          <div><span class="qhr-card-text" x-text="t('ft.wa')">واتساب</span><br>
             <a href="https://wa.me/966580152223" class="qhr-btn qhr-btn--ghost qhr-btn--sm" target="_blank" rel="noopener" dir="ltr">0580152223</a></div>
          <div><span class="qhr-card-text" x-text="t('ft.mobile')">الجوال</span><br>
             <a href="tel:+966580152223" class="qhr-btn qhr-btn--ghost qhr-btn--sm" dir="ltr">0580152223</a></div>
          <div><span class="qhr-card-text" x-text="t('ft.email')">البريد</span><br>
             <a href="mailto:wageh.rashid@gmail.com" class="qhr-btn qhr-btn--ghost qhr-btn--sm" dir="ltr">wageh.rashid@gmail.com</a></div>
          <div class="qhr-showcase-flex-wrap">
            <a href="https://wa.me/966580152223" class="qhr-btn qhr-btn--primary qhr-btn--md" target="_blank" rel="noopener">
              <span x-text="t('card.wa')">واتساب</span>
              <svg class="qhr-icon" width="16" height="16" aria-hidden="true"><use href="#qhr-icon-external-link"></use></svg>
            </a>
          </div>
        </div>
      </div>

      <div class="qhr-divider qhr-divider--luxury" role="separator"></div>
      <p class="qhr-card-text">&copy; <span x-text="year">2026</span> <span x-text="t('ft.rights')">جميع الحقوق محفوظة لشركة الانطباع الفريد للديكور</span> · <span lang="en">UIDC</span></p>
    </div>
  </footer>

</body>
</html>
